# Local development only. Production uses the HYPERDRIVE binding in wrangler.jsonc.
DATABASE_URL=postgresql://postgres:password@localhost:5432/secure_console

# Set false only for local HTTP development. Production must remain true.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=admin_session
SESSION_TTL_HOURS=12
PASSWORD_ITERATIONS=210000

# Comma-separated exact origins allowed to submit public quote requests.
PUBLIC_INTAKE_ORIGINS=http://localhost:5173,https://your-customer-site.example

# At least 32 random characters. Store as a Worker secret in production.
IP_HASH_SECRET=replace-with-at-least-32-random-characters
